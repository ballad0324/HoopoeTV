<?xml version="1.0" encoding="utf-8"?>
<!--
  大块面板（顶栅 / 内容面板 / 详情信息卡）：实色卡片。
  v1.7.7 起取消 30% 半透明白玻璃，回到不透明卡片；颜色随 values / values-night 自动明暗。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/shell_card_fill" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/shell_card_stroke" />
</shape>
