<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选胶囊：选中=浅色容器底 + 主题色描边，未选=白卡底 + 灰描边（v1.7.7 去高光去透明） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_primary_container" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/skin_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_card_fill" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/shell_card_stroke" />
        </shape>
    </item>
</selector>
