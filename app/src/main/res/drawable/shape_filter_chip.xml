<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选胶囊：选中=浮层底 L2 + 外框线（中性，不用主题色染），未选=卡片 L1 + 细线 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/skin_bg_float" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/skin_frame" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/skin_bg_card" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="?attr/skin_line" />
        </shape>
    </item>
</selector>
