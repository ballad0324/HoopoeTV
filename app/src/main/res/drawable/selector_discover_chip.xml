<?xml version="1.0" encoding="utf-8"?>
<!-- 「发现」页筛选胶囊：选中=浮层 L2 + 外框线，未选=卡片 L1 + 细线（v1.7.29 中性化） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/skin_bg_float" />
            <stroke android:width="1dp" android:color="?attr/skin_frame" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/skin_bg_card" />
            <stroke android:width="1dp" android:color="?attr/skin_line" />
        </shape>
    </item>
</selector>