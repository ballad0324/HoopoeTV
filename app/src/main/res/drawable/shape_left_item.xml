<?xml version="1.0" encoding="utf-8"?>
<!-- 左侧分类导航项：与首页/直播按钮同款圆角与底色，未选中不加边框；上下内缩留出菜单之间的外间距 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="7dp" android:bottom="7dp">
                <shape>
                    <corners android:radius="15mm" />
                    <solid android:color="?attr/color_theme_40" />
                    <stroke android:width="2mm" android:color="@android:color/white" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="7dp" android:bottom="7dp">
                <shape>
                    <corners android:radius="15mm" />
                    <solid android:color="?attr/color_theme_40" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="7dp" android:bottom="7dp">
                <shape>
                    <corners android:radius="15mm" />
                    <solid android:color="@color/color_3D3D3D_50" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
