<?xml version="1.0" encoding="utf-8"?>
<!-- 集数格子：未选=透明 + 1px 描边线；选中=浮层 L2 + 1px 评分色描边（彩色只占用描边这一极小块） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/skin_bg_float" />
            <corners android:radius="?attr/skin_radius" />
            <stroke android:width="1dp" android:color="?attr/skin_rating" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="?attr/skin_radius" />
            <stroke android:width="1dp" android:color="?attr/skin_line" />
        </shape>
    </item>
</selector>