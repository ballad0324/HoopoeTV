<?xml version="1.0" encoding="utf-8"?>
<!-- 集数格子：选中主色实心，默认白底细描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/skin_accent" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/skin_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shell_card_fill" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/shell_card_stroke" />
        </shape>
    </item>
</selector>
