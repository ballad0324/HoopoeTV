<?xml version="1.0" encoding="utf-8"?>
<!-- 管理面板：账号状态 / 数据源 / 数据清理 / 版本 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="10dp"
            android:text="@string/m_back"
            android:textColor="@color/shell_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="管理面板"
            android:textColor="@color/shell_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:text="账号"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rowAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shell_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvAccountHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/shell_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="4dp"
                android:text="数据源"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rowSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shell_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSourceHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/shell_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 未登录时的提示：这一整块（胶囊 + 三个地址）在未登录时隐藏 -->
            <TextView
                android:id="@+id/tvSourceLoginHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_setting_card"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:text="未登录：先在设置页填接口地址使用；登录后可在这里切换内置源 / 解析源，并配置接口、直播、EPG"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 登录后才显示：源模式胶囊 + 接口地址 / 直播源 / EPG -->
            <LinearLayout
                android:id="@+id/llSourceConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 源模式胶囊：内置源 / 解析源（自填接口），决定首页实际走哪条源 -->
            <LinearLayout
                android:id="@+id/llSourceMode"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_home_segment_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tvModeBuiltin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="内置源"
                    android:textColor="@color/shell_text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvModeCustom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="解析源"
                    android:textColor="@color/shell_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/shell_text_dim"
                android:textSize="11sp" />

            <!-- 接口地址 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_setting_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="接口地址"
                        android:textColor="@color/shell_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvSaveApi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp"
                        android:text="保存"
                        android:textColor="@color/shell_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etApiUrl"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/shape_filter_chip"
                    android:hint="填 TVBox 标准 json 接口地址"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/shell_text"
                    android:textColorHint="@color/shell_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 直播源 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="直播源"
                        android:textColor="@color/shell_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvSaveLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp"
                        android:text="保存"
                        android:textColor="@color/shell_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etLiveUrl"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/shape_filter_chip"
                    android:hint="m3u / txt 直播源地址"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/shell_text"
                    android:textColorHint="@color/shell_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- EPG 地址 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EPG 地址"
                        android:textColor="@color/shell_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvSaveEpg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp"
                        android:text="保存"
                        android:textColor="@color/shell_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etEpgUrl"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/shape_filter_chip"
                    android:hint="EPG 地址（可留空）"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/shell_text"
                    android:textColorHint="@color/shell_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="4dp"
                android:text="数据清理"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rowClearHistory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/shape_setting_card"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="清空播放历史"
                android:textColor="@color/shell_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowClearFav"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_card"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="清空我的收藏"
                android:textColor="@color/shell_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowClearCache"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_card"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="清理本地缓存"
                android:textColor="@color/shell_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="4dp"
                android:text="云端备份"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rowCloud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="云备份"
                    android:src="@drawable/ic_cloud"
                    android:tint="@color/shell_text_dim" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="云备份"
                        android:textColor="@color/shell_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvCloudHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/shell_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/shell_text_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/shell_text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
