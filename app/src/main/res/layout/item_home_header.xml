<?xml version="1.0" encoding="utf-8"?>
<!-- 首页列表头部（网格第一项，随列表滚动）：快捷胶囊 + 首页/收藏夹分段 + 继续观看横条 + 小编推荐标题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 快捷胶囊：发现 · 收藏 · 继续观看 -->
    <LinearLayout
        android:id="@+id/llQuickBar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_home_quick_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/tvQuickDiscover"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="发现"
            android:textColor="@color/shell_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:textColor="@color/shell_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuickFav"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="收藏"
            android:textColor="@color/shell_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:textColor="@color/shell_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuickContinue"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="继续观看"
            android:textColor="@color/shell_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 分段控件：首页 | 收藏夹 -->
    <LinearLayout
        android:id="@+id/llSegment"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/shape_home_segment_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tvSegHome"
            android:layout_width="94dp"
            android:layout_height="match_parent"
            android:background="@drawable/shape_home_segment_on"
            android:gravity="center"
            android:text="播放历史"
            android:textColor="@color/shell_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSegFav"
            android:layout_width="94dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="收藏夹"
            android:textColor="@color/shell_text_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 横条标题行：继续观看 / 我的收藏 + 清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="继续观看"
            android:textColor="@color/shell_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:text="清空"
            android:textColor="@color/shell_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 横条卡片区：历史与收藏共用同一块位置，按分段切换（同一时间只显示一个） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFav"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:gravity="center"
            android:text="还没有播放记录"
            android:textColor="@color/shell_text_dim"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFavEmpty"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:gravity="center"
            android:text="还没有收藏"
            android:textColor="@color/shell_text_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 小编推荐标题行：与网格同宽，随列表一起滑走 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="16dp"
        android:paddingEnd="2dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="小编推荐"
            android:textColor="@color/shell_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSectionMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:text="更多 ›"
            android:textColor="@color/shell_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
