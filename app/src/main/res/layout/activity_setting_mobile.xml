<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/v_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="@color/shell_text"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/shell_outline" />

    <!-- 界面模式：分段按钮（手机端 / 电视端）——已取消显示，改由首页右上角图标一键切换 -->
    <LinearLayout
        android:id="@+id/cardUiMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/shape_setting_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/m_ui_mode"
            android:textColor="@color/shell_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModeCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/shell_text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_segment_bg"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tvModeMobile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/selector_mode_segment"
                android:gravity="center"
                android:text="@string/m_ui_mobile"
                android:textColor="@color/shell_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvModeTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/selector_mode_segment"
                android:gravity="center"
                android:text="@string/m_ui_tv"
                android:textColor="@color/shell_text"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部 dock 栏：四页共用 -->
    <androidx.compose.ui.platform.ComposeView android:id="@+id/cvDock" android:layout_width="match_parent" android:layout_height="wrap_content" />

</LinearLayout>
