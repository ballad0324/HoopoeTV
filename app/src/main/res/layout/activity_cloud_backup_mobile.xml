<?xml version="1.0" encoding="utf-8"?>
<!-- 云备份（MySQL）：账号配置 + 上传 / 下载 / 云端列表（入口：首页右上角用户面板） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="10dp"
            android:text="@string/m_back"
            android:textColor="@color/shell_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="云备份"
            android:textColor="@color/shell_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvAccountHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/shell_text_dim"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:text="服务器地址"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCloudUrl"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/shape_setting_card"
                android:hint="http://43.226.44.105:6066/tvbox"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/shell_text"
                android:textColorHint="@color/shell_text_dim"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="4dp"
                android:text="用户名"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCloudUser"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/shape_setting_card"
                android:hint="用户名"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/shell_text"
                android:textColorHint="@color/shell_text_dim"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="4dp"
                android:text="密码"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCloudPass"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/shape_setting_card"
                android:hint="密码"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/shell_text"
                android:textColorHint="@color/shell_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCloudSave"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="保存并测试连接"
                android:textColor="@color/shell_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCloudStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_setting_card"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:textColor="@color/shell_text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnCloudPush"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="上传最新备份到云端"
                android:textColor="@color/shell_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnCloudPull"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="从云端下载最新备份"
                android:textColor="@color/shell_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnCloudList"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="查看云端备份列表"
                android:textColor="@color/shell_text"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
