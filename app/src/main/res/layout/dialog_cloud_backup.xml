<?xml version="1.0" encoding="utf-8"?>
<!-- 手机端「云端备份（MySQL）」设置弹窗 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_dialog_bg"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="云端备份（MySQL）"
            android:textColor="#0F1720"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="备份上传到你服务器的 MacCMS 数据库，换手机/重装后一键拉回。App 不直连 MySQL，走服务器上的 PHP 接口。"
            android:textColor="#6B7686"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="接口地址"
            android:textColor="#33405A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCloudUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shape_setting_input"
            android:hint="http://你的域名/tvbox/"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="#0F1720"
            android:textColorHint="#9AA5B5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="用户名"
            android:textColor="#33405A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCloudUser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shape_setting_input"
            android:hint="服务端 install.sql 里建的账号"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="#0F1720"
            android:textColorHint="#9AA5B5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="密码"
            android:textColor="#33405A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCloudPass"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shape_setting_input"
            android:hint="服务端账号密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="#0F1720"
            android:textColorHint="#9AA5B5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCloudStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:text="未测试"
            android:textColor="#6B7686"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCloudSave"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/shape_capsule_track"
                android:gravity="center"
                android:text="保存配置"
                android:textColor="#33405A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCloudTest"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/shape_capsule_on"
                android:gravity="center"
                android:text="测试连接"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCloudPush"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/shape_capsule_on"
                android:gravity="center"
                android:text="上传备份"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCloudPull"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/shape_capsule_on"
                android:gravity="center"
                android:text="一键拉取"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCloudList"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/shape_capsule_track"
                android:gravity="center"
                android:text="云端列表"
                android:textColor="#33405A"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloudClose"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_capsule_track"
            android:gravity="center"
            android:text="关闭"
            android:textColor="#33405A"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
