<?xml version="1.0" encoding="utf-8"?>
<!-- 登录弹窗：服务器地址 + 用户名 + 密码（复用云端备份那套 PHP 账号） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="账号登录"
        android:textColor="?attr/skin_text_1"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="登录后固定使用内置源；不登录则使用你自己填的接口"
        android:textColor="?attr/skin_text_2"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="服务器地址"
        android:visibility="gone"
        android:textColor="?attr/skin_text_2"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etServer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shape_setting_card"
        android:hint="http://43.226.44.105:6066/tvbox"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="?attr/skin_text_1"
        android:textColorHint="?attr/skin_text_2"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="用户名"
        android:textColor="?attr/skin_text_2"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etUser"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shape_setting_card"
        android:hint="用户名"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="?attr/skin_text_1"
        android:textColorHint="?attr/skin_text_2"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="密码"
        android:textColor="?attr/skin_text_2"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etPass"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shape_setting_card"
        android:hint="密码"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="?attr/skin_text_1"
        android:textColorHint="?attr/skin_text_2"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="邀请码（注册用，登录可留空）"
        android:textColor="?attr/skin_text_2"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etInvite"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shape_setting_card"
        android:hint="邀请码"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="?attr/skin_text_1"
        android:textColorHint="?attr/skin_text_2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLoginTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/skin_text_2"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/shape_setting_card"
            android:gravity="center"
            android:text="取消"
            android:textColor="?attr/skin_text_2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/shape_setting_card"
            android:gravity="center"
            android:text="注册"
            android:textColor="?attr/skin_text_1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/shape_setting_card"
            android:gravity="center"
            android:text="登录"
            android:textColor="?attr/skin_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
