<?xml version="1.0" encoding="utf-8"?>
<!-- 本周推荐卡（统一风格）：封面 + 底部渐变遮罩信息区（播放圆钮 + 标题 + 副标题） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="148dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_hist_cover"
        android:clipToOutline="true"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/img_loading_placeholder" />

    <View
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/ivPlay"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_vod_play"
            android:contentDescription="播放"
            android:padding="6dp"
            android:src="@drawable/play_play" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>