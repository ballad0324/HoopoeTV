<?xml version="1.0" encoding="utf-8"?>
<!-- 手机端首页：toolbar + 分类 tab + 内容 pager + 底部导航 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_page"
    android:orientation="vertical">

    <!-- 顶部工具栏（搜索入口已移到底部导航，这里只保留 logo 与标题） -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/glass_card"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/shell_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 切换到电视端（设置页的「界面模式」已取消，改由右上角一键切换） -->
        <ImageView
            android:id="@+id/btnUiMode"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="切换到电视端"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ui_tv"
            android:tint="@color/shell_text_dim" />

        <!-- 明暗模式切换（v1.7.1：图标改成月亮，明亮模式显示月亮、深色模式显示太阳） -->
        <ImageView
            android:id="@+id/btnTheme"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="明暗模式"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_moon"
            android:tint="@color/shell_text_dim" />

        <!-- 用户入口（v1.6.36）：原这里是齿轮设置，改为用户头像，
             点开弹用户面板：设置 / 管理面板 / 下载管理 -->
        <ImageView
            android:id="@+id/btnUser"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="用户"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_user_avatar"
            android:tint="@color/shell_text_dim" />

    </LinearLayout>

    <!-- 分类 tab 已从顶部移到底部（v1.6.29 起由 Compose 绘制，见 HomeDockBar.kt）：
         顶部只留 toolbar，内容区直接顶上来 -->

    <!-- 内容区：一张大玻璃卡。收藏/历史/小编推荐标题已移进列表首项（item_home_header），
         因此这里只剩 ViewPager，整块内容随列表自然滚动，不再靠改容器高度裁剪 -->
    <LinearLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="@drawable/glass_card"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>


    <!-- 首页收起列表面板时由它吃掉剩余高度，保证底部 dock 栏始终贴底 -->
    <View
        android:id="@+id/panelSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <View
        android:id="@+id/navDivider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/shell_outline" />

    <!-- 底部导航栏（Compose 重写）：上行分类 tab（原顶部那排挪下来）+ 下行四图标 dock。
         整块由 mobile/ui/compose/HomeDockBar.kt 绘制，高度 wrap_content。 -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


</LinearLayout>
