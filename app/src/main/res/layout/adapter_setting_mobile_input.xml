<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/shape_setting_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/itemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/shell_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/itemHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:textColor="@color/shell_text_dim"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/itemInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/shape_setting_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@color/shell_text_dim"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/shell_text"
        android:textColorHint="@color/shell_text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/itemAction"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/shape_capsule_on"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
